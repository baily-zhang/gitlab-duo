diff --git a/packages/cli/src/utils/hook_lifecycle_service.test.ts b/packages/cli/src/utils/hook_lifecycle_service.test.ts
new file mode 100644
index 000000000..8e54a4832
--- /dev/null
+++ b/packages/cli/src/utils/hook_lifecycle_service.test.ts
@@ -0,0 +1,429 @@
+import { beforeEach, describe, expect, it, jest, mock } from 'bun:test';
+import { mocked } from '@gitlab-org/test-utils/bun-mocks';
+import { runAllTimersAsync } from '@gitlab-org/test-utils/bun-timers';
+import { createFakePartial } from '@gitlab-org/test-utils';
+import { TestLogger } from '@gitlab-org/logging';
+import type { ConfigService } from '@gitlab-org/config';
+import type { HookService } from '@gitlab-org/hooks';
+import type { ChatElement, ErrorMessage, Message, ToolCall } from '@gitlab-org/tui';
+import { AgentEventType, type RetryAgentEvent } from '../backend/backend';
+import type { Session, SessionManager } from '../sessions';
+import type { ParsedCliInput } from '../parse';
+import { HookLifecycleService } from './hook_lifecycle_service';
+
+async function* streamOf(
+  ...elements: (ChatElement | RetryAgentEvent)[]
+): AsyncGenerator<ChatElement | RetryAgentEvent> {
+  for (const el of elements) {
+    yield el;
+  }
+}
+
+// eslint-disable-next-line require-yield
+async function* throwingStream(): AsyncGenerator<ChatElement | RetryAgentEvent> {
+  throw new Error('stream failure');
+}
+
+async function collectAll(
+  gen: AsyncGenerator<ChatElement | RetryAgentEvent>,
+): Promise<(ChatElement | RetryAgentEvent)[]> {
+  const results: (ChatElement | RetryAgentEvent)[] = [];
+  for await (const el of gen) {
+    results.push(el);
+  }
+  return results;
+}
+
+/** Lets fire-and-forget dispatch promises settle. */
+async function flushMicrotasks(): Promise<void> {
+  await new Promise((resolve) => {
+    setTimeout(resolve, 0);
+  });
+}
+
+const retryEvent: RetryAgentEvent = {
+  type: AgentEventType.Retry,
+  attempt: 1,
+  maxAttempts: 5,
+  backoffMs: 3000,
+  timestamp: 1000,
+};
+
+const messageElement = createFakePartial<Message>({
+  type: 'message',
+  role: 'assistant',
+  content: 'hello',
+  isComplete: true,
+});
+
+const errorElement = createFakePartial<ErrorMessage>({
+  type: 'error',
+  error: 'something went wrong',
+});
+
+const approvalElement = createFakePartial<ToolCall>({
+  type: 'tool',
+  name: 'write_file',
+  state: { type: 'approval_request', content: '' },
+});
+
+const completedToolElement = createFakePartial<ToolCall>({
+  type: 'tool',
+  name: 'write_file',
+  state: { type: 'success', output: 'done' },
+});
+
+describe('HookLifecycleService', () => {
+  let service: HookLifecycleService;
+  let logger: TestLogger;
+  let mockHookService: HookService;
+  let mockSessionManager: SessionManager;
+  let mockConfigService: ConfigService;
+
+  beforeEach(() => {
+    logger = new TestLogger();
+
+    mockHookService = createFakePartial<HookService>({
+      runObserverEvent: mock<HookService['runObserverEvent']>().mockResolvedValue(undefined),
+    });
+
+    mockSessionManager = createFakePartial<SessionManager>({
+      getActiveSession: mock<SessionManager['getActiveSession']>().mockReturnValue(
+        createFakePartial<Session>({ sessionId: 'session-1' }),
+      ),
+    });
+
+    mockConfigService = createFakePartial<ConfigService>({
+      get: mock().mockReturnValue(undefined) as ConfigService['get'],
+    });
+
+    service = new HookLifecycleService(
+      logger,
+      mockHookService,
+      mockSessionManager,
+      mockConfigService,
+      createFakePartial<ParsedCliInput>({ cwd: '/test/cwd', enableProjectHooks: false }),
+    );
+  });
+
+  describe('observeStream', () => {
+    it('passes through all elements unchanged, including retry events', async () => {
+      const elements = await collectAll(
+        service.observeStream(streamOf(retryEvent, messageElement)),
+      );
+
+      expect(elements).toEqual([retryEvent, messageElement]);
+    });
+
+    describe('when the stream completes normally', () => {
+      it('dispatches Stop with status ok', async () => {
+        await collectAll(service.observeStream(streamOf(messageElement)));
+        await flushMicrotasks();
+
+        expect(mockHookService.runObserverEvent).toHaveBeenCalledTimes(1);
+        expect(mockHookService.runObserverEvent).toHaveBeenCalledWith(
+          { name: 'Stop', status: 'ok' },
+          'session-1',
+          '/test/cwd',
+          { enableProjectHooks: false },
+        );
+      });
+    });
+
+    describe('when the stream is empty', () => {
+      it('dispatches Stop with status ok', async () => {
+        await collectAll(service.observeStream(streamOf()));
+        await flushMicrotasks();
+
+        expect(mockHookService.runObserverEvent).toHaveBeenCalledWith(
+          { name: 'Stop', status: 'ok' },
+          'session-1',
+          '/test/cwd',
+          { enableProjectHooks: false },
+        );
+      });
+    });
+
+    describe('when the last element is an error', () => {
+      it('dispatches Stop with status error', async () => {
+        await collectAll(service.observeStream(streamOf(messageElement, errorElement)));
+        await flushMicrotasks();
+
+        expect(mockHookService.runObserverEvent).toHaveBeenCalledTimes(1);
+        expect(mockHookService.runObserverEvent).toHaveBeenCalledWith(
+          { name: 'Stop', status: 'error' },
+          'session-1',
+          '/test/cwd',
+          { enableProjectHooks: false },
+        );
+      });
+    });
+
+    describe('when the last element is a tool awaiting approval', () => {
+      it('dispatches PermissionRequest and no Stop', async () => {
+        await collectAll(service.observeStream(streamOf(messageElement, approvalElement)));
+        await flushMicrotasks();
+
+        expect(mockHookService.runObserverEvent).toHaveBeenCalledTimes(1);
+        expect(mockHookService.runObserverEvent).toHaveBeenCalledWith(
+          { name: 'PermissionRequest' },
+          'session-1',
+          '/test/cwd',
+          { enableProjectHooks: false },
+        );
+      });
+
+      it('ignores a trailing retry event when deciding the settle state', async () => {
+        await collectAll(service.observeStream(streamOf(approvalElement, retryEvent)));
+        await flushMicrotasks();
+
+        expect(mockHookService.runObserverEvent).toHaveBeenCalledWith(
+          { name: 'PermissionRequest' },
+          'session-1',
+          '/test/cwd',
+          { enableProjectHooks: false },
+        );
+      });
+    });
+
+    describe('when the last tool element is not awaiting approval', () => {
+      it('dispatches Stop with status ok', async () => {
+        await collectAll(service.observeStream(streamOf(completedToolElement)));
+        await flushMicrotasks();
+
+        expect(mockHookService.runObserverEvent).toHaveBeenCalledWith(
+          { name: 'Stop', status: 'ok' },
+          'session-1',
+          '/test/cwd',
+          { enableProjectHooks: false },
+        );
+      });
+    });
+
+    describe('when the stream throws', () => {
+      it('dispatches Stop with status error and re-throws', async () => {
+        await expect(collectAll(service.observeStream(throwingStream()))).rejects.toThrow(
+          'stream failure',
+        );
+        await flushMicrotasks();
+
+        expect(mockHookService.runObserverEvent).toHaveBeenCalledTimes(1);
+        expect(mockHookService.runObserverEvent).toHaveBeenCalledWith(
+          { name: 'Stop', status: 'error' },
+          'session-1',
+          '/test/cwd',
+          { enableProjectHooks: false },
+        );
+      });
+    });
+
+    describe('when the consumer abandons the stream early', () => {
+      it('does not dispatch any event (the stream never settled)', async () => {
+        const gen = service.observeStream(streamOf(messageElement, messageElement));
+        await gen.next();
+        await gen.return(undefined);
+        await flushMicrotasks();
+
+        expect(mockHookService.runObserverEvent).not.toHaveBeenCalled();
+      });
+    });
+
+    describe('when hook execution rejects', () => {
+      it('logs the failure without affecting the stream consumer', async () => {
+        mocked(mockHookService.runObserverEvent).mockRejectedValue(new Error('hook exploded'));
+
+        const elements = await collectAll(service.observeStream(streamOf(messageElement)));
+        await flushMicrotasks();
+
+        expect(elements).toEqual([messageElement]);
+        const warning = logger.warnLogs.find((entry) =>
+          entry.message?.includes('Failed to run Stop hooks'),
+        );
+        expect(warning).toBeDefined();
+        expect(warning?.error).toBeInstanceOf(Error);
+      });
+    });
+
+    describe('when a workspace root is configured', () => {
+      it('dispatches with the workspace folder path instead of the launch cwd', async () => {
+        mockConfigService = createFakePartial<ConfigService>({
+          get: mock().mockReturnValue([
+            { uri: 'file:///repo/root', name: 'repository root' },
+          ]) as ConfigService['get'],
+        });
+        service = new HookLifecycleService(
+          logger,
+          mockHookService,
+          mockSessionManager,
+          mockConfigService,
+          createFakePartial<ParsedCliInput>({ cwd: '/test/cwd', enableProjectHooks: false }),
+        );
+
+        await collectAll(service.observeStream(streamOf(messageElement)));
+        await flushMicrotasks();
+
+        expect(mockHookService.runObserverEvent).toHaveBeenCalledWith(
+          { name: 'Stop', status: 'ok' },
+          'session-1',
+          '/repo/root',
+          { enableProjectHooks: false },
+        );
+      });
+
+      it('memoizes the resolved workspace root across dispatches', async () => {
+        let folders = [{ uri: 'file:///repo/root', name: 'repository root' }];
+        mockConfigService = createFakePartial<ConfigService>({
+          get: mock(() => folders) as ConfigService['get'],
+        });
+        service = new HookLifecycleService(
+          logger,
+          mockHookService,
+          mockSessionManager,
+          mockConfigService,
+          createFakePartial<ParsedCliInput>({ cwd: '/test/cwd', enableProjectHooks: false }),
+        );
+
+        await collectAll(service.observeStream(streamOf(messageElement)));
+        await flushMicrotasks();
+
+        folders = [{ uri: 'file:///other/root', name: 'repository root' }];
+        await collectAll(service.observeStream(streamOf(messageElement)));
+        await flushMicrotasks();
+
+        expect(mockHookService.runObserverEvent).toHaveBeenNthCalledWith(
+          2,
+          { name: 'Stop', status: 'ok' },
+          'session-1',
+          '/repo/root',
+          { enableProjectHooks: false },
+        );
+      });
+    });
+
+    describe('when there is no active session', () => {
+      it('does not dispatch any event', async () => {
+        mocked(mockSessionManager.getActiveSession).mockReturnValue(undefined);
+
+        await collectAll(service.observeStream(streamOf(messageElement)));
+        await flushMicrotasks();
+
+        expect(mockHookService.runObserverEvent).not.toHaveBeenCalled();
+      });
+    });
+  });
+
+  describe('drain', () => {
+    it('resolves immediately when no hook runs are in flight', async () => {
+      await service.drain();
+
+      expect(mockHookService.runObserverEvent).not.toHaveBeenCalled();
+    });
+
