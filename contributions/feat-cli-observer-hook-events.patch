@@ -0,0 +1,112 @@
+import type { ChatElement } from '@gitlab-org/tui';
+import { Service, ServiceLifetime, type AsyncDisposable } from '@gitlab/needle';
+import { Logger, withPrefix } from '@gitlab-org/logging';
+import { doNotAwait } from '@gitlab-org/core';
+import { HookService, type ObserverHookEvent } from '@gitlab-org/hooks';
+import { AgentEventType, type RetryAgentEvent } from '../backend/backend';
+import { SessionManager } from '../sessions';
+import { ParsedCliInput } from '../parse';
+
+/**
+ * Fires observer lifecycle hook events at turn boundaries and on shutdown:
+ *
+ * - `PermissionRequest` — the stream settled on a tool call awaiting approval.
+ * - `Stop` — the stream settled back to idle (`status` is `ok` or `error`).
+ * - `SessionEnd` — the CLI session is shutting down.
+ *
+ * The settle conditions mirror `TerminalProgressService.trackStream`
+ * exactly. Hooks are fire-and-forget: dispatches are not awaited by the
+ * consuming turn, stdout is ignored, and failures are logged without ever
+ * affecting the main flow.
+ */
+@Service({
+  dependencies: [Logger, HookService, SessionManager, ParsedCliInput],
+  lifetime: ServiceLifetime.Singleton,
+})
+export class HookLifecycleService implements AsyncDisposable {
+  #logger: Logger;
+
+  #hookService: HookService;
+
+  #sessionManager: SessionManager;
+
+  #cwd: string;
+
+  #enableProjectHooks: boolean;
+
+  #inFlight = new Set<Promise<void>>();
+
+  constructor(
+    logger: Logger,
+    hookService: HookService,
+    sessionManager: SessionManager,
+    cliInput: ParsedCliInput,
+  ) {
+    this.#logger = withPrefix(logger, '[HookLifecycle]');
+    this.#hookService = hookService;
+    this.#sessionManager = sessionManager;
+    this.#cwd = cliInput.cwd;
+    this.#enableProjectHooks = cliInput.enableProjectHooks;
+  }
+
+  /**
+   * Passes the stream through unchanged and dispatches exactly one observer
+   * event when it settles: `PermissionRequest` if the last element is a tool
+   * call awaiting approval, otherwise `Stop`. A stream abandoned early by its
+   * consumer never settles, so no event is dispatched for it.
+   */
+  async *observeStream(
+    stream: AsyncGenerator<ChatElement | RetryAgentEvent>,
+  ): AsyncGenerator<ChatElement | RetryAgentEvent> {
+    let lastElement: ChatElement | undefined;
+
+    try {
+      for await (const element of stream) {
+        yield element;
+        if (element.type !== AgentEventType.Retry) {
+          lastElement = element;
+        }
+      }
+    } catch (error) {
+      this.#dispatch({ name: 'Stop', status: 'error' });
+      throw error;
+    }
+
+    if (lastElement?.type === 'error') {
+      this.#dispatch({ name: 'Stop', status: 'error' });
+    } else if (lastElement?.type === 'tool' && lastElement.state.type === 'approval_request') {
+      this.#dispatch({ name: 'PermissionRequest' });
+    } else {
+      this.#dispatch({ name: 'Stop', status: 'ok' });
+    }
+  }
+
+  /**
+   * Dispatches `SessionEnd` and drains in-flight hook runs so short-lived
+   * hooks get a chance to finish before the process exits. The ExitHandler's
+   * shutdown timeout caps how long this can take.
+   */
+  async disposeAsync(): Promise<void> {
+    this.#dispatch({ name: 'SessionEnd' });
+    await Promise.allSettled([...this.#inFlight]);
+  }
+
+  #dispatch(event: ObserverHookEvent): void {
+    const sessionId = this.#sessionManager.getActiveSession()?.sessionId;
+    if (!sessionId) {
+      this.#logger.debug(`Skipping ${event.name} hooks: no active session`);
+      return;
+    }
+
+    const run = this.#hookService
+      .runObserverEvent(event, sessionId, this.#cwd, {
+        enableProjectHooks: this.#enableProjectHooks,
+      })
+      .catch((error) => {
+        this.#logger.warn(`Failed to run ${event.name} hooks`, error);
+      });
+
+    this.#inFlight.add(run);
+    doNotAwait(run.finally(() => this.#inFlight.delete(run)));
+  }
+}
