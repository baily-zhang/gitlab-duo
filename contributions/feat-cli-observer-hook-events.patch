@@ -0,0 +1,190 @@
+import type { ChatElement } from '@gitlab-org/tui';
+import { Service, ServiceLifetime, type AsyncDisposable } from '@gitlab/needle';
+import { Logger, withPrefix } from '@gitlab-org/logging';
+import { ConfigService } from '@gitlab-org/config';
+import { doNotAwait } from '@gitlab-org/core';
+import { workspaceFolderPathFromUri } from '@gitlab-org/fs';
+import { HookService, type ObserverHookEvent } from '@gitlab-org/hooks';
+import { AgentEventType, type RetryAgentEvent } from '../backend/backend';
+import { SessionManager } from '../sessions';
+import { ParsedCliInput } from '../parse';
+
+/**
+ * Caps {@link HookLifecycleService.drain} so a slow hook cannot stall
+ * shutdown; mirrors the ExitHandler's own shutdown timeout.
+ */
+const DRAIN_TIMEOUT_MS = 5_000;
+
+/**
+ * Fires observer lifecycle hook events at turn boundaries and on shutdown:
+ *
+ * - `PermissionRequest` — the stream settled on a tool call awaiting approval.
+ * - `Stop` — the stream settled back to idle (`status` is `ok` or `error`).
+ * - `SessionEnd` — the CLI session is shutting down.
+ *
+ * The settle conditions mirror `TerminalProgressService.trackStream`
+ * exactly. Hooks are fire-and-forget: dispatches are not awaited by the
+ * consuming turn, stdout is ignored, and failures are logged without ever
+ * affecting the main flow.
+ */
+@Service({
+  dependencies: [Logger, HookService, SessionManager, ConfigService, ParsedCliInput],
+  lifetime: ServiceLifetime.Singleton,
+})
+export class HookLifecycleService implements AsyncDisposable {
+  #logger: Logger;
+
+  #hookService: HookService;
+
+  #sessionManager: SessionManager;
+
+  #configService: ConfigService;
+
+  #fallbackCwd: string;
+
+  #enableProjectHooks: boolean;
+
+  #inFlight = new Set<Promise<void>>();
+
+  /**
+   * The session id of the most recent dispatch, so `SessionEnd` can still be
+   * attributed to the session that ran even when the active session has
+   * already been cleared by the time the container is disposed.
+   */
+  #capturedSessionId: string | undefined;
+
+  /** Memoized by {@link HookLifecycleService.#resolveCwd}. */
+  #resolvedCwd: string | undefined;
+
+  constructor(
+    logger: Logger,
+    hookService: HookService,
+    sessionManager: SessionManager,
+    configService: ConfigService,
+    cliInput: ParsedCliInput,
+  ) {
+    this.#logger = withPrefix(logger, '[HookLifecycle]');
+    this.#hookService = hookService;
+    this.#sessionManager = sessionManager;
+    this.#configService = configService;
+    this.#fallbackCwd = cliInput.cwd;
+    this.#enableProjectHooks = cliInput.enableProjectHooks;
+  }
+
+  /**
+   * Passes the stream through unchanged and dispatches exactly one observer
+   * event when it settles: `PermissionRequest` if the last element is a tool
+   * call awaiting approval, otherwise `Stop`. A stream abandoned early by its
+   * consumer never settles, so no event is dispatched for it.
+   */
+  async *observeStream(
+    stream: AsyncGenerator<ChatElement | RetryAgentEvent>,
+  ): AsyncGenerator<ChatElement | RetryAgentEvent> {
+    let lastElement: ChatElement | undefined;
+
+    try {
+      for await (const element of stream) {
+        yield element;
+        if (element.type !== AgentEventType.Retry) {
+          lastElement = element;
+        }
+      }
+    } catch (error) {
+      this.#dispatch({ name: 'Stop', status: 'error' });
+      throw error;
+    }
+
+    if (lastElement?.type === 'error') {
+      this.#dispatch({ name: 'Stop', status: 'error' });
+    } else if (lastElement?.type === 'tool' && lastElement.state.type === 'approval_request') {
+      this.#dispatch({ name: 'PermissionRequest' });
+    } else {
+      this.#dispatch({ name: 'Stop', status: 'ok' });
+    }
+  }
+
+  /**
+   * Waits for every dispatched hook run to settle, capped at
+   * {@link DRAIN_TIMEOUT_MS}. Exit paths must call this before triggering DI
+   * teardown: the HookExecutor disposes earlier than this service and kills
+   * any hook process still active, so an undrained fire-and-forget dispatch
+   * (e.g. the Stop hooks of a headless run) would be silently terminated.
+   */
+  async drain(): Promise<void> {
+    if (this.#inFlight.size === 0) {
+      return;
+    }
+
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try {
+      const outcome = await Promise.race([
+        Promise.allSettled([...this.#inFlight]).then(() => 'settled' as const),
+        new Promise<'timeout'>((resolve) => {
+          timer = setTimeout(() => resolve('timeout'), DRAIN_TIMEOUT_MS);
+        }),
+      ]);
+      if (outcome === 'timeout') {
+        this.#logger.warn(
+          `Observer hook drain timed out with ${this.#inFlight.size} hooks in flight`,
+        );
+      }
+    } finally {
+      clearTimeout(timer);
+    }
+  }
+
+  /**
+   * Dispatches `SessionEnd` and drains in-flight hook runs so short-lived
+   * hooks get a chance to finish before the process exits. The ExitHandler's
+   * shutdown timeout caps this in addition to the drain cap.
+   */
+  async disposeAsync(): Promise<void> {
+    this.#dispatch({ name: 'SessionEnd' });
+    await this.drain();
+  }
+
+  /**
+   * Dispatched events are fire-and-forget notifications. When one stream is
+   * abandoned and a new turn starts, no relative ordering is guaranteed
+   * between their events, so consumers must not treat the event sequence as
+   * a strict state machine.
+   */
+  #dispatch(event: ObserverHookEvent): void {
+    const sessionId =
+      event.name === 'SessionEnd'
+        ? (this.#capturedSessionId ?? this.#sessionManager.getActiveSession()?.sessionId)
+        : this.#sessionManager.getActiveSession()?.sessionId;
+    if (!sessionId) {
+      this.#logger.debug(`Skipping ${event.name} hooks: no active session`);
+      return;
+    }
+    this.#capturedSessionId = sessionId;
+
+    const run = this.#hookService
+      .runObserverEvent(event, sessionId, this.#resolveCwd(), {
+        enableProjectHooks: this.#enableProjectHooks,
+      })
+      .catch((error) => {
+        this.#logger.warn(`Failed to run ${event.name} hooks`, error);
+      });
+
+    this.#inFlight.add(run);
+    doNotAwait(run.finally(() => this.#inFlight.delete(run)));
+  }
+
+  /**
+   * The workspace root resolved during initialization — the same directory
+   * SessionStart hooks receive — so project hook configs are looked up
+   * consistently when the CLI runs from a subdirectory. Memoized on first
+   * resolution so every event of the session reports the same cwd even if
+   * the configured workspace changes mid-session.
+   */
+  #resolveCwd(): string {
+    if (this.#resolvedCwd === undefined) {
+      const folders = this.#configService.get('workspaceFolders') || [];
+      this.#resolvedCwd =
+        folders.length > 0 ? workspaceFolderPathFromUri(folders[0].uri) : this.#fallbackCwd;
+    }
+    return this.#resolvedCwd;
+  }
+}
